{
  "schema": "agentdeck/tool@1",
  "slug": "example-issue",
  "name": "示例工具（单据操作：绑定参数，每个动作一套参数）",
  "version": "1.0.0",
  "description": "范例工具，不会真的改动任何单据：它有两个动作，各有一套参数，其中一个动作还带平台自动填上的绑定参数（工作区 / 执行）。用来看看各种参数长什么样。",
  "runtime": "node",
  "entry": "scripts/tag.mjs",
  "actions": [
    {
      "name": "tag",
      "summary": "模拟给单据打一个标签（不真的改，把 label/是否加摘要/工作区 id 写成 issue-ops.log）",
      "reversible": true,
      "dryRun": "supported",
      "timeoutMs": 10000,
      "params": {
        "bound": {
          "dir": { "from": "workdir" },
          "workspace-id": { "from": "workspace.id" }
        },
        "open": {
          "label": { "type": "enum", "values": ["bug", "feature", "tech-debt", "blocked", "needs-info"] },
          "add-summary": { "type": "boolean" }
        }
      }
    },
    {
      "name": "close",
      "summary": "模拟关闭单据（不真的关，把 reason 写成 issue-ops.log）",
      "entry": "scripts/close.mjs",
      "reversible": false,
      "dryRun": "supported",
      "timeoutMs": 10000,
      "params": {
        "bound": {
          "dir": { "from": "workdir" },
          "workspace-id": { "from": "workspace.id" }
        },
        "open": {
          "reason": { "type": "string", "max": 500 }
        }
      }
    }
  ]
}
