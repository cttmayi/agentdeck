{
  "schema": "agentdeck/tool@1",
  "slug": "example-notify",
  "name": "示例工具（发通知：平台/渠道参数）",
  "version": "1.0.0",
  "description": "范例工具，不会真的发出通知：它接受「平台/渠道」等参数，把收到的参数记在工作目录里——用来看看判决给过来的参数长什么样。",
  "runtime": "node",
  "entry": "scripts/send.mjs",
  "actions": [
    {
      "name": "send",
      "summary": "模拟发一条通知（不真的发，把 channel/title/content/urgent/retries 原样写成 notify.log）",
      "reversible": true,
      "dryRun": "supported",
      "timeoutMs": 10000,
      "params": {
        "bound": {
          "dir": { "from": "workdir" },
          "run-id": { "from": "subject.runId" }
        },
        "open": {
          "channel": { "type": "enum", "values": ["dingtalk", "wecom", "feishu", "slack", "email"] },
          "title": { "type": "string", "max": 200 },
          "content": { "type": "string", "max": 2000 },
          "urgent": { "type": "boolean" },
          "retries": { "type": "integer", "min": 0, "max": 10 }
        }
      }
    }
  ]
}
