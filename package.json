{
  "name": "agentdeck",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.test.json && pnpm --filter @agentdeck/web run check",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\" \"apps/web/server/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "check": "pnpm run typecheck && pnpm run test",
    "daemon": "node apps/daemon/src/cli.ts",
    "remote": "node apps/remote/src/cli.ts",
    "mcp": "node apps/mcp/src/cli.ts",
    "cli": "node apps/cli/src/cli.ts",
    "build:web": "pnpm --filter @agentdeck/web run build",
    "dev:web": "pnpm --filter @agentdeck/web run dev",
    "probe:layout": "node tools/layout-probe/run.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
