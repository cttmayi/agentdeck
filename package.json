{
  "name": "agentdeck",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.test.json && tsc --noEmit -p apps/web/tsconfig.test.json && tsc --noEmit -p apps/remote/web/tsconfig.test.json && pnpm --filter @agentdeck/web run check && pnpm --filter @agentdeck/remote-web run check",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\" \"apps/*/web/src/**/*.test.ts\" \"apps/web/server/**/*.test.ts\" \"tools/*/src/**/*.test.ts\" \"tests/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "test:watch": "node --test --watch \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\" \"apps/*/web/src/**/*.test.ts\" \"tools/*/src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "check": "pnpm run typecheck && pnpm run test",
    "daemon": "node scripts/node-entry.mjs apps/daemon/src/cli.ts",
    "remote": "node scripts/node-entry.mjs apps/remote/src/cli.ts",
    "mcp": "node scripts/node-entry.mjs apps/mcp/src/cli.ts",
    "cli": "node scripts/node-entry.mjs apps/cli/src/cli.ts",
    "sync-skills": "node scripts/node-entry.mjs tools/skill-catalog-sync/src/cli.ts",
    "build:web": "pnpm --filter @agentdeck/web run build && pnpm --filter @agentdeck/remote-web run build",
    "dev:web": "pnpm --filter @agentdeck/web run dev",
    "probe:layout": "node tools/layout-probe/run.mjs",
    "build:remote-web": "pnpm --filter @agentdeck/remote-web run build",
    "probe:remote": "node tools/remote-ui-probe/run.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0"
  }
}
